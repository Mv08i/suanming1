{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "prisma generate --schema=./prisma/schema.prisma && npm run build",
  "outputDirectory": ".next",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/divine/interpret",
      "headers": [
        { "key": "X-Accel-Buffering", "value": "no" },
        { "key": "X-Buffering", "value": "off" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-cache, no-transform" }
      ]
    },
    {
      "source": "/api/ai/chat",
      "headers": [
        { "key": "X-Accel-Buffering", "value": "no" },
        { "key": "X-Buffering", "value": "off" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-cache, no-transform" }
      ]
    }
  ]
}
