// Auth.js v5 + Prisma Adapter schema
// 文档: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // 邮箱密码登录用的 bcrypt 哈希
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  balance        CreditBalance?
  rechargeOrders RechargeOrder[]
  transactions   CreditTransaction[]
  aiRequests     AiRequest[]
  divinations    DivinationRecord[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 积分余额表（注册时自动创建一行）
model CreditBalance {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int      @default(0) // 当前可用积分
  totalCharged Int      @default(0) // 累计充值
  totalUsed    Int      @default(0) // 累计消耗
  updatedAt    DateTime @updatedAt

  @@map("credit_balances")
}

// 充值订单（一次充值对应一行）
model RechargeOrder {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creemCheckoutId    String    @unique // Creem checkout session id（用于 webhook 匹配）
  creemTransactionId String?   // 支付成功后 Creem 返回的 transaction id
  creemCustomerId    String?   // Creem customer id
  productId          String    // Creem product id
  amountUsdCents     Int       // 支付金额（美分，避免浮点）
  credits            Int       // 本单到账积分数
  status             String    @default("PENDING") // PENDING / PAID / FAILED
  createdAt          DateTime  @default(now())
  paidAt             DateTime?

  transactions CreditTransaction[]

  @@index([userId])
  @@index([status])
  @@map("recharge_orders")
}

// 积分流水（每次余额变动一行，便于审计）
model CreditTransaction {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String          // RECHARGE / USE / REFUND
  amount       Int             // 积分变化（正=充值/回退到账，负=消耗）
  balanceAfter Int             // 操作后余额快照
  orderId      String?
  order        RechargeOrder?  @relation(fields: [orderId], references: [id])
  requestId    String?         // 关联 AiRequest（USE/REFUND 类流水，软关联：不设 FK 避免约束）
  description  String?
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([requestId])
  @@map("credit_transactions")
}

// 每次 AI 调用记录（便于审计、失败回退、按实际消耗结算）
model AiRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model           String   // 使用的模型，如 "gpt-4o-mini"
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  // 结算：按次固定扣费 5 积分（预留字段，将来可换成按 token 计费）
  creditsReserved Int      @default(0) // 预扣积分
  creditsCharged  Int      @default(0) // 实际扣费（=成功扣的；失败=0）
  creditsRefunded Int      @default(0) // 回退积分（失败时把预扣退回去）
  status          String   // PENDING / SUCCESS / FAILED / REFUNDED
  errorMessage    String?
  // 调用分类：CHAT（通用对话）/ LIUYAO（六爻）/ MEIHUA（梅花易数）/ QIMEN（奇门遁甲）。可空兼容老数据。
  category        String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([category])
  @@map("ai_requests")
}

// 算命记录（每次起卦+解卦对应一行，存结构化卦象与历史）
model DivinationRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // LIUYAO | MEIHUA | QIMEN
  question    String?  // 用户所问之事
  castData    Json     // 服务端终判的结构化卦象（复现/审计用）
  summary     String?  // 解卦完成后缓存的首段摘要（可选，全文走 AiRequest 即可）
  requestId   String?  // 软关联 AiRequest.id（不设 FK，避免约束，与 CreditTransaction 一致）
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@map("divination_records")
}
